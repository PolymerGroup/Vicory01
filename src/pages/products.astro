---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ComplianceNotice from '../components/ComplianceNotice.astro';
import { SITE } from '../lib/site';
import data from '../data/peptides.json';
import type { Peptide } from '../types/peptide';

const products = data.products as unknown as Peptide[];
const categories = data.categories;
const totalSkus = products.reduce((n, p) => n + p.specs.length, 0);

const initialCategory = Astro.url.searchParams.get('category') || 'all';
const initialQuery = Astro.url.searchParams.get('q') || '';

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Dchemi research peptide catalogue',
  numberOfItems: products.length,
  itemListElement: products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `${SITE.url}/peptides/${p.slug}`,
  })),
};
---

<Layout
  title="All 119 Research Peptides — Catalog & Tier Pricing | Dchemi"
  description="Browse all 119 research peptides at Dchemi with CAS numbers, sequences, ≥99% HPLC purity, per-kit (10 vials/kit) tier pricing, and instant B2B RFQ inquiry support."
  exactTitle
  path="/products"
  structuredData={[itemListLd]}
>
  <!-- Page header -->
  <section class="border-b border-slate-200 bg-white">
    <div class="container-x py-10">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
        <a href="/" class="hover:text-ocean-700">Home</a>
        <span class="px-1.5 text-slate-300">/</span>
        <span class="font-medium text-slate-700">Products</span>
      </nav>

      <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-slateink sm:text-4xl">
            Research peptide catalogue
          </h1>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
            {products.length} products · {totalSkus} pack-size SKUs · all prices in <strong>USD per kit of 10 vials</strong>.
            Filter by research area or search by name, short code, CAS or alias.
          </p>
        </div>
        <div class="flex gap-2">
          <a href="/llms-full.txt" class="btn-secondary btn-sm">Machine-readable data</a>
          <a href="/rfq" class="btn-primary btn-sm">Request quote</a>
        </div>
      </div>
    </div>
  </section>

  <ComplianceNotice variant="bar" />

  <!-- Toolbar -->
  <section class="sticky top-16 z-30 border-b border-slate-200 bg-lab/95 backdrop-blur">
    <div class="container-x py-4">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex flex-1 items-center gap-2">
          <label for="product-search" class="sr-only">Search products</label>
          <div class="relative w-full max-w-md">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" stroke-linecap="round" />
            </svg>
            <input
              id="product-search"
              type="search"
              placeholder="Search name, short code, CAS or alias…"
              value={initialQuery}
              class="field !py-2.5 pl-9"
              autocomplete="off"
              spellcheck="false"
            />
          </div>
          <p id="result-count" class="hidden whitespace-nowrap text-xs font-medium text-slate-500 sm:block">
            {products.length} results
          </p>
        </div>

        <div class="flex items-center gap-2">
          <label for="sort-by" class="text-xs font-medium text-slate-500">Sort</label>
          <select id="sort-by" class="field !w-auto !py-2 pr-8 text-sm">
            <option value="name">Name A–Z</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="specs">Pack sizes: most first</option>
          </select>
          <button type="button" id="clear-filters" class="btn-ghost btn-sm border border-slate-200">Reset</button>
        </div>
      </div>

      <div id="category-chips" class="mt-3 flex gap-2 overflow-x-auto pb-1 no-scrollbar" role="tablist" aria-label="Filter by category">
        <button
          type="button"
          class="chip js-cat shrink-0 !border-slateink !bg-slateink !text-white"
          data-category="all"
          aria-pressed="true"
        >
          All products <span class="font-mono opacity-70">{products.length}</span>
        </button>
        {
          categories.map((c) => (
            <button
              type="button"
              class="chip js-cat shrink-0"
              data-category={c.key}
              aria-pressed={initialCategory === c.key ? 'true' : 'false'}
            >
              {c.short} <span class="font-mono opacity-70">{c.count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="container-x py-10">
    <div id="product-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {
        products.map((p) => (
          <div
            data-product
            data-category={p.category}
            data-search={`${p.searchTerms} ${p.name.toLowerCase()} ${p.shortCode.toLowerCase()}`}
            data-name={p.name.toLowerCase()}
            data-price={p.priceFrom ?? 0}
            data-specs={p.specs.length}
            class="[content-visibility:auto] [contain-intrinsic-size:420px]"
          >
            <ProductCard product={p} />
          </div>
        ))
      }
    </div>

    <div id="empty-state" class="hidden rounded-2xl border border-dashed border-slate-300 py-16 text-center">
      <p class="text-sm font-semibold text-slateink">No products match this filter</p>
      <p class="mt-1 text-xs text-slate-500">
        Try a shorter search term, or <a href="/rfq" class="font-semibold text-ocean-700">ask us for a custom sourcing request</a>.
      </p>
      <button type="button" id="empty-reset" class="btn-secondary btn-sm mt-4">Reset filters</button>
    </div>
  </section>

  <section class="container-x pb-20">
    <div class="card p-6 sm:p-8">
      <div class="grid gap-6 md:grid-cols-3">
        <div>
          <p class="label">Pricing model</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Every line is quoted per kit of 10 vials in USD. 1–9 kits, 10–49 kits and 50+ kits carry
            different unit prices; mixing products is allowed for volume review.
          </p>
        </div>
        <div>
          <p class="label">Documentation</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Lot-specific COA (RP-HPLC + ESI-MS), packing list and MSDS accompany every shipment.
            Batch PDFs can be pre-shared for institutional approval.
          </p>
        </div>
        <div>
          <p class="label">Need something not listed?</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            We source custom sequences, GMP-adjacent grades and private-label presentation from 50
            kits per SKU. <a href="/rfq" class="font-semibold text-ocean-700">Send a sourcing request</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    const grid = document.getElementById('product-grid') as HTMLElement | null;
    const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('[data-product]')) : [];
    const search = document.getElementById('product-search') as HTMLInputElement | null;
    const sortSel = document.getElementById('sort-by') as HTMLSelectElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.js-cat'));
    const resultCount = document.getElementById('result-count');
    const emptyState = document.getElementById('empty-state');
    const originalOrder = [...cards];

    const params = new URLSearchParams(location.search);
    let activeCategory = (params.get('category') || 'all').toLowerCase();

    function syncChips() {
      chips.forEach((c) => {
        const on = (c.dataset.category || 'all') === activeCategory;
        c.classList.toggle('!border-slateink', on);
        c.classList.toggle('!bg-slateink', on);
        c.classList.toggle('!text-white', on);
        c.setAttribute('aria-pressed', String(on));
      });
    }

    function apply() {
      const q = (search?.value || '').trim().toLowerCase();
      let visible = 0;

      for (const card of cards) {
        const cat = (card.dataset.category || '').toLowerCase();
        const text = card.dataset.search || '';
        const okCat = activeCategory === 'all' || cat === activeCategory;
        const okText = !q || text.includes(q);
        const show = okCat && okText;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }

      // 排序只在可见集合上生效
      const mode = sortSel?.value || 'name';
      const visibleCards = cards.filter((c) => !c.classList.contains('hidden'));
      visibleCards.sort((a, b) => {
        if (mode === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
        if (mode === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
        if (mode === 'specs') return Number(b.dataset.specs) - Number(a.dataset.specs);
        return String(a.dataset.name).localeCompare(String(b.dataset.name));
      });
      for (const c of visibleCards) grid?.appendChild(c);

      if (resultCount) resultCount.textContent = `${visible} result${visible === 1 ? '' : 's'}`;
      emptyState?.classList.toggle('hidden', visible !== 0);

      const url = new URL(location.href);
      if (activeCategory === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', activeCategory);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url.toString());
    }

    chips.forEach((c) =>
      c.addEventListener('click', () => {
        activeCategory = (c.dataset.category || 'all').toLowerCase();
        syncChips();
        apply();
      })
    );

    let t: number | undefined;
    search?.addEventListener('input', () => {
      window.clearTimeout(t);
      t = window.setTimeout(apply, 120);
    });
    sortSel?.addEventListener('change', apply);

    const reset = () => {
      if (search) search.value = '';
      if (sortSel) sortSel.value = 'name';
      activeCategory = 'all';
      syncChips();
      for (const c of originalOrder) grid?.appendChild(c);
      apply();
    };
    document.getElementById('clear-filters')?.addEventListener('click', reset);
    document.getElementById('empty-reset')?.addEventListener('click', reset);

    syncChips();
    apply();
  </script>
</Layout>
