---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PepArticleCard from '../../components/PepArticleCard.astro';
import ComplianceNotice from '../../components/ComplianceNotice.astro';
import { PEPPEDIA_CATEGORIES, categoryLabel } from '../../lib/peppedia';
import { SITE, abs } from '../../lib/site';

const posts = (await getCollection('peppedia')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id);

const counts = Object.keys(PEPPEDIA_CATEGORIES).map((key) => ({
  key,
  label: categoryLabel(key),
  count: posts.filter((p) => p.data.category === key).length,
}));

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${SITE.url}/peppedia#collection`,
  name: 'PepPedia — peptide research & analytics library',
  description:
    'Practical, non-clinical articles on research peptide handling, analytics, nomenclature and B2B sourcing.',
  url: `${SITE.url}/peppedia`,
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  hasPart: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: `${SITE.url}/peppedia/${p.id}`,
    datePublished: p.data.publishedAt.toISOString().slice(0, 10),
  })),
};
---

<Layout
  title="PepPedia — Peptide Research, Analytics & Sourcing Library"
  description="Practical articles on research peptides: certificate of analysis interpretation, RP-HPLC and ESI-MS testing, purity vs content, lyophilised powder handling, sequence notation and B2B RFQ checklists."
  path="/peppedia"
  structuredData={[collectionLd]}
>
  <Breadcrumbs items={[{ label: 'PepPedia' }]} />

  <!-- Hero -->
  <section class="border-b border-slate-200 bg-white">
    <div class="container-x py-12">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <p class="label">Knowledge base</p>
          <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slateink sm:text-4xl">
            PepPedia
          </h1>
          <p class="mt-3 text-[15px] leading-7 text-slate-600">
            Working notes on research peptides — how they are made, how they are tested, how they
            should be handled, and what to ask before you buy. Written for laboratory and
            procurement teams; no clinical or dosing content.
          </p>
        </div>
        <dl class="flex gap-8">
          <div>
            <dt class="label">Articles</dt>
            <dd class="mt-1 font-mono text-3xl font-extrabold text-slateink">{posts.length}</dd>
          </div>
          <div>
            <dt class="label">Topics</dt>
            <dd class="mt-1 font-mono text-3xl font-extrabold text-slateink">{counts.filter((c) => c.count).length}</dd>
          </div>
        </dl>
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/peppedia" class="chip border-slateink bg-slateink !text-white">All topics</a>
        {
          counts.filter((c) => c.count).map((c) => (
            <a href={`/peppedia?topic=${c.key}`} class="chip js-topic" data-topic={c.key}>
              {c.label} <span class="font-mono opacity-60">{c.count}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ComplianceNotice variant="bar" />

  <!-- Featured -->
  <section class="container-x pt-10">
    <PepArticleCard entry={featured} featured />
  </section>

  <!-- Grid -->
  <section class="container-x py-10">
    <div id="article-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        rest.map((p) => (
          <div data-topic={p.data.category} class="[content-visibility:auto]">
            <PepArticleCard entry={p} />
          </div>
        ))
      }
    </div>

    <div id="empty-topic" class="hidden rounded-2xl border border-dashed border-slate-300 py-14 text-center">
      <p class="text-sm font-semibold text-slateink">No articles in this topic yet</p>
      <p class="mt-1 text-xs text-slate-500">Browse all topics instead.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x pb-20">
    <div class="grid gap-4 md:grid-cols-3">
      <a href="/quality-coa" class="card p-5 transition-shadow hover:shadow-lift">
        <p class="label">Quality</p>
        <p class="mt-2 text-sm font-bold text-slateink">Batch testing & COA centre</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">Methods, release specification and lot lookup.</p>
      </a>
      <a href="/products" class="card p-5 transition-shadow hover:shadow-lift">
        <p class="label">Catalogue</p>
        <p class="mt-2 text-sm font-bold text-slateink">All research peptides</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">119 products in 10-vial kits with tier pricing.</p>
      </a>
      <a href="/rfq" class="card p-5 transition-shadow hover:shadow-lift">
        <p class="label">Procurement</p>
        <p class="mt-2 text-sm font-bold text-slateink">Request a quotation</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">Line-by-line quote with COA and freight.</p>
      </a>
    </div>
  </section>

  <script>
    const chips = Array.from(document.querySelectorAll<HTMLAnchorElement>('.js-topic'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('#article-grid > [data-topic]'));
    const empty = document.getElementById('empty-topic');
    const params = new URLSearchParams(location.search);
    const initial = params.get('topic');

    function apply(topic: string | null) {
      let visible = 0;
      for (const card of cards) {
        const show = !topic || card.dataset.topic === topic;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }
      chips.forEach((c) => {
        const on = (c.dataset.topic ?? null) === topic;
        c.classList.toggle('border-slateink', on);
        c.classList.toggle('bg-slateink', on);
        c.classList.toggle('text-white', on);
      });
      empty?.classList.toggle('hidden', visible !== 0 || !topic);
      const url = new URL(location.href);
      if (topic) url.searchParams.set('topic', topic);
      else url.searchParams.delete('topic');
      history.replaceState(null, '', url.toString());
    }

    chips.forEach((c) =>
      c.addEventListener('click', (e) => {
        e.preventDefault();
        const topic = c.dataset.topic ?? null;
        apply(topic === initial ? null : topic);
      })
    );

    if (initial) apply(initial);
  </script>
</Layout>
