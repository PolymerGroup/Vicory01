---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { money } from '../../lib/site';
import { CATEGORY_PAGES } from '../../lib/categories';
import data from '../../data/peptides.json';
import type { Peptide } from '../../types/peptide';

const all = data.products as unknown as Peptide[];
const TODAY = new Date().toISOString().slice(0, 10);

const rows = CATEGORY_PAGES.map((c) => {
  const items = all.filter((p) => p.category === c.key);
  return {
    c,
    count: items.length,
    skus: items.reduce((n, p) => n + p.specs.length, 0),
    from: Math.min(...items.map((p) => p.priceFrom ?? Infinity)),
    short: items.map((p) => p.shortCode).slice(0, 8),
  };
});

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Peptide categories',
  url: 'https://dchemi.com/peptides',
  dateModified: TODAY,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: rows.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://dchemi.com/peptides/${r.c.slug}`,
      name: r.c.h1,
    })),
  },
};
---

<Layout
  title="Peptide Categories — Browse by Research Area | Dchemi"
  description="Seven catalogue categories: GLP-1 and metabolic peptides, repair and recovery, cosmetic and dermal, GH secretagogues, bioregulators, blends and ancillary reagents."
  exactTitle
  path="/peptides"
  structuredData={[listLd]}
>
  <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Categories' }]} />
    <header class="mt-6 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Catalogue</p>
      <h1 class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-slateink sm:text-4xl">
        Browse by research area
      </h1>
      <p class="mt-4 text-base leading-7 text-slate-700">
        Every product in the catalogue belongs to one of seven groups. Each group page lists the
        analytical characteristics that matter for that family, the pack sizes available and the
        questions buyers ask most often.
      </p>
      <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-slate-400">
        Last reviewed: {TODAY} · Research use only
      </p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        rows.map(({ c, count, skus, from, short }) => (
          <a
            href={`/peptides/${c.slug}`}
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-brand-300"
          >
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-base font-bold text-slateink group-hover:text-brand-700">{c.h1}</h2>
              <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-semibold text-slate-600">
                {count} products
              </span>
            </div>
            <p class="mt-2 text-[13px] leading-6 text-slate-600">{c.intro[0]}</p>
            <p class="mt-3 font-mono text-[11px] text-slate-500">
              {skus} SKUs · from {money(from)} / kit · {short.join(' ')}
            </p>
          </a>
        ))
      }
    </div>

    <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-5">
      <p class="text-sm font-semibold text-slateink">Looking for the full list instead?</p>
      <p class="mt-1 text-sm text-slate-600">
        The complete catalogue with search, sort and filters lives at
        <a href="/products" class="font-semibold text-ocean-700 hover:underline">/products</a>.
      </p>
    </div>
  </section>
</Layout>
