---
import Layout from '../layouts/Layout.astro';
import ComplianceNotice from '../components/ComplianceNotice.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';
import data from '../data/peptides.json';

const sampleSlugs = ['bpc-157', 'tirzepatide', 'ghk-cu'];
const samples = sampleSlugs
  .map((s) => (data.products as any[]).find((p) => p.slug === s))
  .filter(Boolean);

const methods = [
  {
    k: 'Identity',
    m: 'ESI-MS',
    spec: 'Observed mass within ±0.5 Da of theoretical',
    detail: 'Positive-ion electrospray, mass range 500–6000 m/z, deconvoluted against the theoretical sequence mass.',
  },
  {
    k: 'Purity',
    m: 'RP-HPLC',
    spec: '≥ 99.0 % by area normalisation',
    detail: 'C18 column, water/acetonitrile gradient with 0.1 % TFA, detection at 214 nm and 280 nm.',
  },
  {
    k: 'Water content',
    m: 'Karl Fischer',
    spec: '≤ 5.0 % (lyophilized powder)',
    detail: 'Coulometric titration; residual moisture above limit triggers re-lyophilisation.',
  },
  {
    k: 'Endotoxin',
    m: 'LAL',
    spec: '≤ 5 EU/mg where applicable',
    detail: 'Limulus amebocyte lysate kinetic assay, performed on request for injectable-grade lots.',
  },
  {
    k: 'Appearance',
    m: 'Visual / particulate',
    spec: 'White to off-white lyophilized cake',
    detail: 'Inspected against a black and white background; discoloration or shrinkage triggers rejection.',
  },
  {
    k: 'Sterility (liquids)',
    m: 'Membrane filtration',
    spec: 'No growth, 14-day incubation',
    detail: 'Applied to ancillary reagents supplied as sterile solutions, not to lyophilized powders.',
  },
];

const faqs = [
  {
    q: 'Is the COA product-specific or batch-specific?',
    a: 'Batch-specific. Every lot receives its own certificate with a unique lot number in the format VC-2026-[CODE]-01. The lot number is printed on each vial label and on the outer kit box.',
  },
  {
    q: 'Can you send the COA before we place an order?',
    a: 'Yes. Send the product short code and target quantity to info@dchemi.com or WhatsApp, and we will attach the most recent lot COA for evaluation.',
  },
  {
    q: 'Do you provide third-party testing?',
    a: 'Routine release testing is performed in-house against our specification. Independent third-party HPLC/MS verification can be arranged on request for larger orders.',
  },
  {
    q: 'How long are records retained?',
    a: 'Chromatograms, mass spectra and release documentation are retained for twelve months and can be re-issued on request during that period.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Quality & COA Centre — RP-HPLC, ESI-MS, Batch Traceability"
  description="How Dchemi tests every research peptide batch: RP-HPLC purity ≥99%, ESI-MS identity, Karl Fischer water content, LAL endotoxin. Request a batch-specific certificate of analysis."
  path="/quality-coa"
  structuredData={[faqLd]}
>
  <Breadcrumbs items={[{ label: 'Quality & COA' }]} />

  <section class="border-b border-slate-200 bg-white">
    <div class="container-x py-12">
      <p class="label">Quality system</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slateink sm:text-4xl">
        Every lot ships with a certificate of analysis
      </h1>
      <p class="mt-3 max-w-3xl text-[15px] leading-7 text-slate-600">
        We release peptides against a written specification, not against a marketing claim. Each
        batch is identified by a lot number, tested for identity and purity, and documented in a
        certificate you can file with your institutional records.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#coa-request" class="btn-primary">Request a batch COA</a>
        <a href="#batch-lookup" class="btn-secondary">Check a lot number</a>
      </div>
    </div>
  </section>

  <ComplianceNotice variant="bar" />

  <!-- Methods -->
  <section class="container-x py-14">
    <h2 class="text-2xl font-bold text-slateink">Analytical methods & specification</h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
      The same release panel applies to every peptide lot. Ancillary reagents follow a reduced panel
      appropriate to their physical form.
    </p>

    <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
      <table class="table-lab min-w-[760px]">
        <caption class="sr-only">Release testing panel</caption>
        <thead>
          <tr>
            <th scope="col">Attribute</th>
            <th scope="col">Method</th>
            <th scope="col">Specification</th>
            <th scope="col">Detail</th>
          </tr>
        </thead>
        <tbody>
          {
            methods.map((m) => (
              <tr>
                <td class="font-semibold text-slateink">{m.k}</td>
                <td class="font-mono text-xs">{m.m}</td>
                <td class="font-mono text-xs text-ocean-800">{m.spec}</td>
                <td class="text-xs leading-5 text-slate-600">{m.detail}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- COA anatomy -->
  <section class="border-y border-slate-200 bg-white py-14">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-start">
      <div>
        <h2 class="text-2xl font-bold text-slateink">What is on the certificate</h2>
        <ol class="mt-5 space-y-4">
          {
            [
              ['Lot identification', 'Batch code VC-2026-[CODE]-01, manufacture and release dates.'],
              ['Product identity', 'Standard name, short code, CAS where published, sequence reference.'],
              ['Analytical results', 'HPLC purity %, retention time, mass found vs theoretical, appearance.'],
              ['Compliance limits', 'Water content, endotoxin (where applicable), sterility for liquids.'],
              ['Authorisation', 'QC reviewer, release date and storage statement.'],
            ].map(([t, d], i) => (
              <li class="flex gap-4">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-100 font-mono text-xs font-bold text-brand-700">
                  {i + 1}
                </span>
                <div>
                  <p class="text-sm font-bold text-slateink">{t}</p>
                  <p class="mt-0.5 text-xs leading-5 text-slate-600">{d}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-7 rounded-2xl border border-slate-200 bg-slate-50 p-5">
          <p class="label">Lot number format</p>
          <p class="mt-2 font-mono text-lg font-bold text-slateink">VC-2026-BC-01</p>
          <p class="mt-1 text-xs leading-5 text-slate-500">
            <span class="font-mono">VC</span> = Vicory · <span class="font-mono">2026</span> = year ·
            <span class="font-mono"> BC</span> = product short code ·
            <span class="font-mono"> 01</span> = batch sequence.
          </p>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="border-b border-slate-200 bg-slate-50/70 px-5 py-4">
          <p class="label">Specimen preview</p>
          <p class="mt-1 text-sm font-bold text-slateink">Certificate sample — illustrative only</p>
        </div>
        <div class="p-5">
          <dl class="divide-y divide-slate-100 text-xs">
            {
              [
                ['Product', 'BPC-157 (BC)'],
                ['Lot', 'VC-2026-BC-01'],
                ['Appearance', 'White lyophilized powder'],
                ['Purity (RP-HPLC)', '≥ 99.0 % (specification)'],
                ['Identity (ESI-MS)', 'Mass confirmed vs theoretical'],
                ['Water content', '≤ 5.0 % (Karl Fischer)'],
                ['Storage', '-20 °C, protected from light'],
              ].map(([k, v]) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-slate-500">{k}</dt>
                  <dd class="text-right font-mono font-semibold text-slate-800">{v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-[11px] leading-4 text-slate-400">
            This specimen shows the document layout and specification limits. Measured values are
            only issued on the lot-specific PDF for the batch you receive.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Batch lookup -->
  <section id="batch-lookup" class="container-x scroll-mt-24 py-14">
    <div class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <div>
        <h2 class="text-2xl font-bold text-slateink">Check a lot number</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Enter the lot code printed on your vial label. Format:
          <span class="font-mono">VC-YYYY-CODE-NN</span>. Our QC team confirms the corresponding
          release record and returns the PDF — typically within one business day.
        </p>
        <p class="mt-3 rounded-xl border border-ocean-200 bg-ocean-50 p-3 text-xs leading-5 text-ocean-900">
          We do not expose batch data publicly. A lot lookup opens a verification request, it does
          not return test values on this page.
        </p>
      </div>

      <form id="lot-form" class="card space-y-3 p-5">
        <div>
          <label for="lot-code" class="label">Lot number</label>
          <input
            id="lot-code"
            name="lot"
            type="text"
            class="field mt-1 font-mono uppercase"
            placeholder="VC-2026-BC-01"
            pattern="[Vv][Cc]-\d{4}-[A-Za-z0-9]{2,8}-\d{1,3}"
            required
          />
        </div>
        <div>
          <label for="lot-email" class="label">Your email</label>
          <input id="lot-email" name="email" type="email" class="field mt-1" placeholder="lab@institution.edu" required />
        </div>
        <p id="lot-hint" class="text-[11px] font-medium text-slate-500">
          Format is validated in your browser before the request is sent.
        </p>
        <button type="submit" class="btn-primary w-full">Request release record</button>
      </form>
    </div>
  </section>

  <!-- COA request -->
  <section id="coa-request" class="border-y border-slate-200 bg-white py-14 scroll-mt-24">
    <div class="container-x">
      <h2 class="text-2xl font-bold text-slateink">Request a COA or ask a QC question</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
        Send the product short code, quantity and destination country. We reply with the current lot
        COA, MSDS and a quotation.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('COA request — Dchemi')}`} class="card p-5 transition-shadow hover:shadow-lift">
          <p class="label">Email</p>
          <p class="mt-2 text-sm font-bold text-slateink">{SITE.email}</p>
          <p class="mt-1 text-xs leading-5 text-slate-500">Attach your product list; we reply with COAs and pricing.</p>
        </a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener" class="card p-5 transition-shadow hover:shadow-lift">
          <p class="label">WhatsApp</p>
          <p class="mt-2 text-sm font-bold text-slateink">{SITE.phone}</p>
          <p class="mt-1 text-xs leading-5 text-slate-500">Fastest channel for batch numbers and stock confirmation.</p>
        </a>
        <a href="/rfq" class="card p-5 transition-shadow hover:shadow-lift">
          <p class="label">RFQ form</p>
          <p class="mt-2 text-sm font-bold text-slateink">Request quotation</p>
          <p class="mt-1 text-xs leading-5 text-slate-500">Multi-item requests with tier pricing and freight.</p>
        </a>
      </div>

      <div class="mt-10">
        <h3 class="text-lg font-bold text-slateink">Sample COA panels</h3>
        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {
            samples.map((s: any) => (
              <a href={`/peptides/${s.slug}`} class="card p-5 hover:shadow-lift">
                <p class="text-sm font-bold text-slateink">{s.name}</p>
                <p class="mt-1 font-mono text-[11px] text-slate-500">
                  Lot {s.coa.lotFormat} · {s.coa.method}
                </p>
                <p class="mt-3 text-xs font-semibold text-ocean-700">View product COA panel →</p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('lot-form') as HTMLFormElement | null;
    const code = document.getElementById('lot-code') as HTMLInputElement | null;
    const email = document.getElementById('lot-email') as HTMLInputElement | null;
    const hint = document.getElementById('lot-hint');
    const PATTERN = /^VC-\d{4}-[A-Z0-9]{2,8}-\d{1,3}$/i;

    code?.addEventListener('input', () => {
      if (!code.value) {
        if (hint) {
          hint.textContent = 'Format is validated in your browser before the request is sent.';
          hint.className = 'text-[11px] font-medium text-slate-500';
        }
        return;
      }
      const ok = PATTERN.test(code.value.trim());
      if (hint) {
        hint.textContent = ok
          ? 'Format accepted — submit to open the verification request.'
          : 'Format should look like VC-2026-BC-01.';
        hint.className = ok
          ? 'text-[11px] font-semibold text-emerald-600'
          : 'text-[11px] font-semibold text-amber-600';
      }
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const lot = code?.value.trim() || '';
      if (!PATTERN.test(lot)) {
        code?.focus();
        return;
      }
      const to = 'info@dchemi.com';
      const subject = `Lot verification — ${lot}`;
      const body = [
        `Lot number: ${lot}`,
        `Requester email: ${email?.value || ''}`,
        '',
        'Please confirm the release record and send the corresponding batch COA PDF.',
        '',
        'For Research, Laboratory, and Analytical Use Only. Not for Human or Veterinary Use.',
      ].join('\n');
      location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      if (hint) {
        hint.textContent = 'Verification request opened in your email client.';
        hint.className = 'text-[11px] font-semibold text-emerald-600';
      }
    });
  </script>
</Layout>
