---
import Layout from '../layouts/Layout.astro';
import ComplianceNotice from '../components/ComplianceNotice.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site';
import data from '../data/peptides.json';

const productCount = data.productCount;
---

<Layout
  title="Request a Quote — B2B RFQ for Research Peptides"
  description="Send a B2B RFQ for research peptides, blends and ancillary reagents. USD tier pricing per 10-vial kit, lot-specific COA, worldwide export. Response within one business day."
  path="/rfq"
>
  <Breadcrumbs items={[{ label: 'Request Quote' }]} />

  <section class="border-b border-slate-200 bg-white">
    <div class="container-x py-12">
      <p class="label">B2B quotation</p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-slateink sm:text-4xl">
        Request a quote
      </h1>
      <p class="mt-3 max-w-3xl text-[15px] leading-7 text-slate-600">
        Tell us what you need and we will return a line-by-line quotation with tier pricing, freight
        options and the matching batch COAs. No online payment — orders are confirmed by proforma
        invoice.
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        <span class="chip">Response within 1 business day</span>
        <span class="chip">{productCount} products available</span>
        <span class="chip">MOQ 1 kit</span>
        <span class="chip">Ships worldwide</span>
      </div>
    </div>
  </section>

  <ComplianceNotice variant="bar" />

  <section class="container-x py-12">
    <div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
      <!-- Form -->
      <div>
        <form id="rfq-form" class="card space-y-5 p-6" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="f-name" class="label">Full name *</label>
              <input id="f-name" name="name" type="text" class="field mt-1" required autocomplete="name" placeholder="Dr. Jane Doe" />
            </div>
            <div>
              <label for="f-company" class="label">Company / institution *</label>
              <input id="f-company" name="company" type="text" class="field mt-1" required autocomplete="organization" placeholder="Example Lab LLC" />
            </div>
            <div>
              <label for="f-email" class="label">Email *</label>
              <input id="f-email" name="email" type="email" class="field mt-1" required autocomplete="email" placeholder="procurement@example.com" />
            </div>
            <div>
              <label for="f-phone" class="label">Phone / WhatsApp</label>
              <input id="f-phone" name="phone" type="tel" class="field mt-1" autocomplete="tel" placeholder="+1 555 010 2030" />
            </div>
            <div>
              <label for="f-country" class="label">Country *</label>
              <input id="f-country" name="country" type="text" class="field mt-1" required autocomplete="country-name" placeholder="United States" />
            </div>
            <div>
              <label for="f-type" class="label">Buyer type *</label>
              <select id="f-type" name="type" class="field mt-1" required>
                <option value="">Select…</option>
                <option>Research laboratory</option>
                <option>Clinic / medical spa</option>
                <option>Distributor / wholesaler</option>
                <option>Compounding pharmacy</option>
                <option>University / institution</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div>
            <div class="flex items-end justify-between gap-3">
              <label for="f-items" class="label">Products & quantities *</label>
              <button type="button" id="import-cart" class="text-[11px] font-semibold text-ocean-700 hover:underline">
                Import from RFQ list
              </button>
            </div>
            <textarea
              id="f-items"
              name="items"
              rows="6"
              class="field mt-1 font-mono text-[13px]"
              required
              placeholder="Retatrutide RT 10mg × 10 kits&#10;BPC-157 BC 5mg × 20 kits&#10;NAD+ NJ 500mg × 10 kits"
            ></textarea>
            <p class="mt-1 text-[11px] text-slate-500">
              One line per product: name, short code, pack size, number of kits.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="f-use" class="label">Intended use *</label>
              <select id="f-use" name="use" class="field mt-1" required>
                <option>Laboratory research</option>
                <option>Analytical reference standard</option>
                <option>Cosmetic raw material (in-vitro R&amp;D)</option>
                <option>Institutional teaching</option>
                <option>Distribution / resale</option>
              </select>
            </div>
            <div>
              <label for="f-ship" class="label">Preferred shipping</label>
              <select id="f-ship" name="shipping" class="field mt-1">
                <option>Express courier (DHL / FedEx)</option>
                <option>Air freight (bulk)</option>
                <option>Buyer’s forwarder</option>
                <option>Not sure — advise me</option>
              </select>
            </div>
          </div>

          <div>
            <label for="f-notes" class="label">Notes</label>
            <textarea id="f-notes" name="notes" rows="3" class="field mt-1" placeholder="Documentation requirements, target delivery date, private-label needs…"></textarea>
          </div>

          <label class="flex items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4">
            <input id="f-consent" type="checkbox" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-500 focus:ring-brand-300" required />
            <span class="text-xs leading-5 text-slate-600">
              I confirm that I represent a business or institution, that products will be used for
              research, laboratory or analytical purposes only, and that they will not be resold or
              administered to humans or animals.
              <span class="mt-1 block font-semibold text-brand-800">{SITE.ruo}</span>
            </span>
          </label>

          <div class="flex flex-wrap items-center gap-3">
            <button type="submit" class="btn-primary" id="rfq-submit">
              Generate quote request
            </button>
            <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('B2B RFQ — Dchemi')}`} class="btn-secondary">
              Email directly
            </a>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-secondary">
              WhatsApp
            </a>
          </div>
          <p id="rfq-status" class="hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-xs font-medium text-emerald-800"></p>
          <p class="text-[11px] leading-4 text-slate-500">
            This form generates a pre-filled email in your mail client. No data is stored on this
            site — the only server call is an optional webhook you configure yourself.
          </p>
        </form>
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <div class="card p-5">
          <p class="label">Your RFQ list</p>
          <div id="cart-summary" class="mt-3 space-y-2 text-sm text-slate-600">
            <p class="text-xs text-slate-500">No items yet — add products from the catalogue.</p>
          </div>
          <div class="mt-3 flex items-center justify-between border-t border-slate-200 pt-3">
            <span class="text-xs font-medium text-slate-500">Estimated subtotal</span>
            <span id="cart-total" class="font-mono text-base font-bold text-slateink">$0.00</span>
          </div>
          <a href="/products" class="btn-secondary btn-sm mt-3 w-full">Browse catalogue</a>
        </div>

        <div class="card p-5">
          <p class="label">What happens next</p>
          <ol class="mt-3 space-y-3 text-xs leading-5 text-slate-600">
            <li><span class="font-bold text-slateink">1.</span> We review stock and documentation.</li>
            <li><span class="font-bold text-slateink">2.</span> You receive a proforma invoice with tier pricing and freight.</li>
            <li><span class="font-bold text-slateink">3.</span> Payment by bank transfer; shipment booked with export documents.</li>
          </ol>
        </div>

        <div class="rounded-2xl border border-ocean-200 bg-ocean-50 p-5">
          <p class="text-sm font-bold text-ocean-900">Prefer to talk?</p>
          <p class="mt-1 text-xs leading-5 text-ocean-900/80">
            Our sales chemists answer technical and documentation questions directly.
          </p>
          <div class="mt-3 space-y-1.5 text-xs font-semibold">
            <a href={`mailto:${SITE.email}`} class="block text-ocean-800 hover:underline">{SITE.email}</a>
            <a href={SITE.phoneHref} class="block text-ocean-800 hover:underline">{SITE.phone}</a>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="block text-ocean-800 hover:underline">WhatsApp chat</a>
          </div>
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <p class="label">Compliance reminder</p>
          <p class="mt-2 text-[11px] leading-5 text-slate-500">{SITE.ruo}</p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    const KEY = 'dchemi.rfq.v1';
    const WEBHOOK = ''; // 预留：填入 Worker URL 即可 POST JSON

    type Item = { slug: string; name: string; shortCode: string; spec: string; label: string; vials: number; price: number; tiers: any[]; qty: number };

    function readCart(): Item[] {
      try {
        const raw = localStorage.getItem(KEY);
        return raw ? (JSON.parse(raw).items as Item[]) || [] : [];
      } catch {
        return [];
      }
    }

    function unitPrice(i: Item) {
      const t = (i.tiers || []).find((x) => i.qty >= x.min && (x.max == null || i.qty <= x.max));
      return t ? t.price : i.price;
    }

    function renderSummary() {
      const items = readCart();
      const box = document.getElementById('cart-summary');
      const totalEl = document.getElementById('cart-total');
      if (!box) return;
      box.innerHTML = '';
      if (!items.length) {
        box.innerHTML = '<p class="text-xs text-slate-500">No items yet — add products from the catalogue.</p>';
        if (totalEl) totalEl.textContent = '$0.00';
        return;
      }
      let total = 0;
      for (const i of items) {
        const line = unitPrice(i) * i.qty;
        total += line;
        const row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-3';
        const left = document.createElement('div');
        left.innerHTML = '';
        const n = document.createElement('p');
        n.className = 'text-xs font-semibold text-slateink';
        n.textContent = i.name;
        const m = document.createElement('p');
        m.className = 'font-mono text-[10px] text-slate-500';
        m.textContent = `${i.shortCode} · ${i.label} · ${i.qty} kit(s)`;
        left.append(n, m);
        const v = document.createElement('p');
        v.className = 'font-mono text-xs font-bold text-slateink';
        v.textContent = `$${line.toFixed(2)}`;
        row.append(left, v);
        box.append(row);
      }
      if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
      return total;
    }

    function buildItemsText(): string {
      const items = readCart();
      if (!items.length) return '';
      return items
        .map((i) => `${i.name} ${i.shortCode} ${i.label} × ${i.qty} kit(s) @ $${unitPrice(i).toFixed(2)}/kit`)
        .join('\n');
    }

    document.getElementById('import-cart')?.addEventListener('click', () => {
      const ta = document.getElementById('f-items') as HTMLTextAreaElement | null;
      const text = buildItemsText();
      if (!ta) return;
      if (!text) {
        ta.focus();
        return;
      }
      ta.value = ta.value.trim() ? `${ta.value.trim()}\n${text}` : text;
    });

    const form = document.getElementById('rfq-form') as HTMLFormElement | null;
    const status = document.getElementById('rfq-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const get = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value?.trim() || '';
      const payload = {
        name: get('f-name'),
        company: get('f-company'),
        email: get('f-email'),
        phone: get('f-phone'),
        country: get('f-country'),
        buyerType: get('f-type'),
        items: get('f-items'),
        intendedUse: get('f-use'),
        shipping: get('f-ship'),
        notes: get('f-notes'),
        consent: (document.getElementById('f-consent') as HTMLInputElement)?.checked === true,
        source: location.href,
        submittedAt: new Date().toISOString(),
      };

      const body = [
        'B2B RFQ — Dchemi',
        `Name: ${payload.name}`,
        `Company: ${payload.company}`,
        `Email: ${payload.email}`,
        `Phone: ${payload.phone}`,
        `Country: ${payload.country}`,
        `Buyer type: ${payload.buyerType}`,
        `Intended use: ${payload.intendedUse}`,
        `Shipping preference: ${payload.shipping}`,
        '',
        'Requested items:',
        payload.items,
        '',
        payload.notes ? `Notes: ${payload.notes}` : '',
        '',
        'For Research, Laboratory, and Analytical Use Only. Not for Human or Veterinary Use.',
      ]
        .filter(Boolean)
        .join('\n');

      if (WEBHOOK) {
        try {
          await fetch(WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
        } catch {
          /* fall through to mailto */
        }
      }

      const subject = `B2B RFQ — ${payload.company} (${payload.country})`;
      location.href = `mailto:info@dchemi.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      if (status) {
        status.textContent = 'Your email client has been opened with the full RFQ. If it did not open, copy the list and send it to info@dchemi.com.';
        status.classList.remove('hidden');
      }
    });

    renderSummary();
    window.addEventListener('storage', (e) => {
      if (e.key === KEY) renderSummary();
    });
  </script>
</Layout>
