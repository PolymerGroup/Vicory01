---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { money } from '../../lib/site';
import { COMPARISONS } from '../../lib/comparisons';
import data from '../../data/peptides.json';
import type { Peptide } from '../../types/peptide';

const products = data.products as unknown as Peptide[];
const TODAY = new Date().toISOString().slice(0, 10);

const items = COMPARISONS.map((c) => ({
  c,
  a: products.find((p) => p.slug === c.a)!,
  b: products.find((p) => p.slug === c.b)!,
}));

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Peptide comparisons',
  url: 'https://dchemi.com/compare',
  dateModified: TODAY,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: items.map((x, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://dchemi.com/compare/${x.c.pair}`,
      name: `${x.a.name} vs ${x.b.name}`,
    })),
  },
};
---

<Layout
  title="Peptide Comparisons — Analytical X vs Y Guides | Dchemi"
  description="Side-by-side analytical comparisons of commonly confused research peptides: sequence, molecular formula and weight, CAS numbers, backbone modifications and per-kit catalogue pricing."
  exactTitle
  path="/compare"
  structuredData={[itemListLd]}
>
  <section class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Comparisons' }]} />

    <header class="mt-6 max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600">Reference library</p>
      <h1 class="mt-2 text-3xl font-extrabold leading-tight tracking-tight text-slateink sm:text-4xl">
        Peptide comparisons
      </h1>
      <p class="mt-4 text-base leading-7 text-slate-700">
        Pairs that are often discussed together but differ in sequence, backbone constraint or
        acylation chemistry. Each page lists the catalogue parameters side by side and explains which
        analytical method discriminates them.
      </p>
      <p class="mt-3 text-[11px] font-medium uppercase tracking-wider text-slate-400">
        Last reviewed: {TODAY} · Research use only
      </p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map(({ c, a, b }) => (
          <a
            href={`/compare/${c.pair}`}
            class="group rounded-2xl border border-slate-200 bg-white p-5 transition-colors hover:border-brand-300"
          >
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              {a.categoryLabel === b.categoryLabel ? a.categoryLabel : `${a.categoryLabel} / ${b.categoryLabel}`}
            </p>
            <h2 class="mt-2 text-base font-bold text-slateink group-hover:text-brand-700">
              {a.name} vs {b.name}
            </h2>
            <p class="mt-2 text-[13px] leading-6 text-slate-600">{c.lead}</p>
            <p class="mt-3 font-mono text-[11px] text-slate-500">
              {a.molecularWeight ? `${a.molecularWeight} Da` : 'COA'} · {b.molecularWeight ? `${b.molecularWeight} Da` : 'COA'}
              {' · from '}
              {money(a.priceFrom)} / {money(b.priceFrom)}
            </p>
          </a>
        ))
      }
    </div>

    <div class="mt-12 rounded-2xl border border-slate-200 bg-slate-50 p-5">
      <p class="text-sm font-semibold text-slateink">Need a pair we have not covered?</p>
      <p class="mt-1 text-sm text-slate-600">
        Send the two product names and the analytical question — we publish new comparisons monthly and
        can supply both materials as 10-vial kits.
      </p>
      <a href="/rfq" class="btn-primary btn-sm mt-4">Request a comparison</a>
    </div>
  </section>
</Layout>
