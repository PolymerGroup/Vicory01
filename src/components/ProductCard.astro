---
import type { Peptide } from '../types/peptide';
import PeptideVialPlaceholder from './PeptideVialPlaceholder.astro';
import AddToRfqButton from './AddToRfqButton.astro';
import { money } from '../lib/site';

interface Props {
  product: Peptide;
  imageUrl?: string | null;
  /** Show the quick add-to-RFQ button */
  withRfq?: boolean;
}

const { product: p, imageUrl = null, withRfq = true } = Astro.props;
const defaultSpec = p.specs[0];
const extraSpecs = p.specs.length - 1;
---

<article class="card group flex h-full flex-col overflow-hidden transition-shadow hover:shadow-lift">
  <a href={`/peptides/${p.slug}`} class="relative block overflow-hidden bg-slate-50" aria-label={`${p.name} details`}>
    <div class="aspect-[420/460] w-full">
      <PeptideVialPlaceholder
        slug={p.slug}
        code={p.shortCode}
        spec={defaultSpec.label}
        purity={p.purity}
        category={p.category}
        imageUrl={imageUrl}
        vials={defaultSpec.vials}
        form={p.form}
        compact
        class="transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </div>
    <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-600 shadow-sm ring-1 ring-slate-200">
      {p.categoryShort}
    </span>
    {p.cas ? (
      <span class="absolute right-3 top-3 rounded-full bg-white/90 px-2.5 py-1 font-mono text-[10px] font-semibold text-slate-600 shadow-sm ring-1 ring-slate-200">
        CAS {p.cas}
      </span>
    ) : null}
  </a>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="text-[15px] font-bold leading-tight text-slateink">
        <a href={`/peptides/${p.slug}`} class="hover:text-ocean-700">{p.name}</a>
      </h3>
      <span class="shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[10px] font-bold text-slate-600">
        {p.shortCode}
      </span>
    </div>

    <p class="mt-1 line-clamp-2 text-xs leading-5 text-slate-500">
      {p.aliases.slice(0, 3).join(' · ') || p.categoryLabel}
    </p>

    <div class="mt-3 flex flex-wrap gap-1.5">
      <span class="chip !py-0.5 text-[10px]">{p.purity || 'Ancillary'}</span>
      <span class="chip !py-0.5 text-[10px]">{defaultSpec.vials} vials/kit</span>
      {extraSpecs > 0 ? (
        <span class="chip !py-0.5 text-[10px]">+{extraSpecs} sizes</span>
      ) : null}
    </div>

    <div class="mt-auto pt-4">
      <div class="flex items-end justify-between gap-2">
        <div>
          <p class="label">From</p>
          <p class="font-mono text-lg font-bold leading-tight text-slateink">
            {money(p.priceFrom)}
            <span class="text-[11px] font-medium text-slate-500">/ kit</span>
          </p>
          {p.priceFrom != null && defaultSpec.perKit != null && p.priceFrom < defaultSpec.perKit ? (
            <p class="text-[10px] leading-4 text-slate-400">best tier · 50+ kits</p>
          ) : (
            <p class="text-[10px] leading-4 text-slate-400">1 kit minimum</p>
          )}
        </div>
        {withRfq ? (
          <AddToRfqButton
            slug={p.slug}
            name={p.name}
            shortCode={p.shortCode}
            spec={defaultSpec}
            variant="secondary"
            label="RFQ"
            class="!px-3"
          />
        ) : null}
      </div>
    </div>
  </div>
</article>

