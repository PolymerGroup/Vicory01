---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Catalogue',
    links: [
      { href: '/peptides/glp1-metabolic', label: 'Metabolic peptides' },
      { href: '/peptides/repair-recovery', label: 'Repair peptides' },
      { href: '/peptides/cosmetic-antiaging', label: 'Cosmetic peptides' },
      { href: '/peptides/blends', label: 'Blends' },
      { href: '/peptides/ancillary', label: 'Ancillary reagents' },
      { href: '/peptides', label: 'All categories' },
    ],
  },
  {
    title: 'PepPedia',
    links: [
      { href: '/peppedia', label: 'All articles' },
      { href: '/peppedia?topic=analytics', label: 'Quality & analytics' },
      { href: '/peppedia?topic=handling', label: 'Handling & storage' },
      { href: '/peppedia?topic=sourcing', label: 'Sourcing & supply' },
      { href: '/peppedia/reading-a-peptide-coa', label: 'How to read a COA' },
      { href: '/compare', label: 'Peptide comparisons' },
    ],
  },
  {
    title: 'Quality',
    links: [
      { href: '/quality-coa', label: 'Quality & COA centre' },
      { href: '/quality-coa#batch-lookup', label: 'Batch lookup' },
      { href: '/quality-coa#coa-request', label: 'Request a COA' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/about-compliance', label: 'About Vicory Biotech' },
      { href: '/about-compliance#supply-chain', label: 'Supply chain standard' },
      { href: '/about-compliance#compliance', label: 'US compliance statement' },
      { href: '/rfq', label: 'Request a quote' },
    ],
  },
];
---

<footer class="mt-24 border-t border-slate-200 bg-white">
  
  <div class="border-b border-brand-100 bg-brand-50">
    <div class="container-x flex flex-col items-start gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-start gap-2 text-[12.5px] font-semibold leading-5 text-brand-900">
        <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{SITE.ruo}</span>
      </p>
      <p class="text-[12px] text-brand-800/80 sm:text-right">B2B only · No online payment · RFQ required</p>
    </div>
  </div>

  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-6">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <img src={SITE.logo} alt={`${SITE.name} logo`} width="40" height="40" class="h-10 w-10 rounded-lg object-contain ring-1 ring-slate-200" loading="lazy" />
        <div>
          <p class="text-base font-extrabold tracking-tight text-slateink">dchemi<span class="text-brand-500">.</span></p>
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-slate-500">{SITE.legalName}</p>
        </div>
      </div>
      <div class="mt-6 space-y-1 text-sm">
        <a
          href={`mailto:${SITE.email}`}
          class="group flex items-center gap-2.5 rounded-lg py-1 text-slate-700 transition-colors hover:text-ocean-700"
        >
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-500 transition-colors group-hover:bg-ocean-50 group-hover:text-ocean-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2.5" />
              <path d="m3.6 6.4 8.4 6 8.4-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="sr-only">Email: </span>{SITE.email}
        </a>
        <a
          href={SITE.phoneHref}
          class="group flex items-center gap-2.5 rounded-lg py-1 text-slate-700 transition-colors hover:text-ocean-700"
        >
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-500 transition-colors group-hover:bg-ocean-50 group-hover:text-ocean-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M6.6 3.5h2.2a1.7 1.7 0 0 1 1.7 1.5l.4 2.6a1.7 1.7 0 0 1-.9 1.7l-1 .5a12.4 12.4 0 0 0 5.2 5.2l.5-1a1.7 1.7 0 0 1 1.7-.9l2.6.4a1.7 1.7 0 0 1 1.5 1.7v2.2a2.4 2.4 0 0 1-2.6 2.4C10.9 20.3 3.7 13.1 3.2 6.1a2.4 2.4 0 0 1 2.4-2.6Z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span class="sr-only">Phone: </span>{SITE.phone}
        </a>
        <a
          href={SITE.whatsapp}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-2.5 rounded-lg py-1 text-slate-700 transition-colors hover:text-ocean-700"
        >
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-slate-100 text-slate-500 transition-colors group-hover:bg-ocean-50 group-hover:text-ocean-700">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.6-6c-.3-.2-1.7-.9-2-1-.3-.1-.5-.2-.7.1-.2.3-.7 1-.9 1.2-.2.2-.4.2-.7.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3.1 4.9 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.2-.6-.4z" />
            </svg>
          </span>
          <span class="sr-only">WhatsApp: </span>Chat with sales
        </a>
      </div>
    </div>

    {cols.map((col) => (
      <nav aria-label={col.title}>
        <p class="label">{col.title}</p>
        <ul class="mt-4 space-y-2.5">
          {col.links.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-slate-600 transition-colors hover:text-ocean-700">{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-slate-200">
    <div class="container-x flex flex-col gap-3 py-6 text-[12.5px] text-slate-500 md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {SITE.legalName}
      </p>
      <p class="max-w-2xl md:text-right">
        Products are sold for laboratory, analytical and research purposes only. Not for human or
        veterinary use. No statement on this site has been evaluated by the FDA.
      </p>
    </div>
  </div>
</footer>
