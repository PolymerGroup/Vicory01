---
import type { Peptide } from '../types/peptide';
import { money } from '../lib/site';

interface Props {
  current: Peptide;
  related: Peptide[];
}

const { current, related } = Astro.props;

/** Chemistry columns: real value when known, otherwise COA (blends show 'mix') */
function chemOf(p: Peptide) {
  const formula = (p as any).molecularFormula ?? p.formula ?? null;
  const isBlend = p.sequenceType === 'blend' || p.category === 'blend';
  const fallback = isBlend ? 'mix → COA' : 'COA';
  return {
    cas: p.cas || fallback,
    formula: formula || fallback,
    mw: p.molecularWeight ? (/da$/i.test(String(p.molecularWeight)) ? p.molecularWeight : `${p.molecularWeight} Da`) : fallback,
  };
}

const rows = [current, ...related].map((p) => ({ p, chem: chemOf(p) }));
---

<section aria-labelledby="compare-heading" class="mt-16">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="compare-heading" class="text-xl font-bold text-slateink">
        Related peptides & parameter comparison
      </h2>
      <p class="mt-1 text-sm text-slate-500">
        Related peptides for {current.name} come from the same research area ({current.categoryLabel}) and are priced per kit of {current.kitVials} vials.
      </p>
    </div>
    <a href={`/products?category=${current.category}`} class="text-sm font-semibold text-ocean-700 hover:text-ocean-800">
      Browse all {current.categoryLabel.split(' ')[0]} →
    </a>
  </div>

  <div class="mt-5 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
    <table class="table-lab min-w-[980px]">
      <caption class="sr-only">Parameter comparison for related research peptides</caption>
      <thead>
        <tr>
          <th scope="col">Product</th>
          <th scope="col">Code</th>
          <th scope="col">CAS</th>
          <th scope="col">Formula</th>
          <th scope="col">MW</th>
          <th scope="col">Purity</th>
          <th scope="col">Pack sizes</th>
          <th scope="col" class="text-right">From / kit</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map(({ p, chem }, i) => (
            <tr class:list={[i === 0 && 'bg-brand-50/40']}>
              <td class="font-semibold text-slateink">
                {i === 0 ? (
                  <>
                    {p.name}
                    <span class="ml-2 rounded bg-brand-500 px-1.5 py-0.5 text-[10px] font-bold uppercase text-white">
                      this item
                    </span>
                  </>
                ) : (
                  <a href={`/peptides/${p.slug}`} class="font-medium text-ocean-700 hover:underline">
                    {p.name}
                  </a>
                )}
              </td>
              <td class="font-mono text-xs">{p.shortCode}</td>
              <td class="font-mono text-xs">{chem.cas}</td>
              <td class="font-mono text-xs">{chem.formula}</td>
              <td class="font-mono text-xs">{chem.mw}</td>
              <td class="text-xs">{p.purity || 'n/a'}</td>
              <td class="text-xs">{p.specs.map((s) => s.label).join(', ')}</td>
              <td class="text-right font-mono text-xs font-bold">{money(p.priceFrom)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
