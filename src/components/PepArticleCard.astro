---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, PEPPEDIA_CATEGORIES } from '../lib/peppedia';

interface Props {
  entry: CollectionEntry<'peppedia'>;
  /** Large card for the featured article */
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
const { title, description, category, publishedAt, readingMinutes } = entry.data;

const dateLabel = publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const accent =
  PEPPEDIA_CATEGORIES[category as keyof typeof PEPPEDIA_CATEGORIES]?.accent ?? 'ocean';

const accentClass =
  accent === 'brand'
    ? 'border-brand-200 bg-brand-50 text-brand-800'
    : accent === 'slate'
      ? 'border-slate-200 bg-slate-100 text-slate-700'
      : 'border-ocean-200 bg-ocean-50 text-ocean-800';
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card transition-all hover:-translate-y-0.5 hover:shadow-lift',
    featured && 'lg:flex-row',
  ]}
>
  {
    featured ? (
      <div class="relative hidden w-2/5 shrink-0 overflow-hidden bg-gradient-to-br from-ocean-600 via-ocean-700 to-slateink lg:block">
        <div class="absolute inset-0 opacity-30 [background-image:radial-gradient(circle_at_20%_20%,#F97316_0,transparent_45%),radial-gradient(circle_at_80%_70%,#38BDF8_0,transparent_45%)]" />
        <div class="relative flex h-full flex-col justify-between p-6 text-white">
          <p class="font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-white/70">PepPedia · Featured</p>
          <p class="text-3xl font-extrabold leading-none tracking-tight text-white/95">Pep<span class="text-brand-300">Pedia</span></p>
          <p class="text-xs leading-5 text-white/70">{categoryLabel(category)} · {readingMinutes} min read</p>
        </div>
      </div>
    ) : null
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2">
      <span class:list={['rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider', accentClass]}>
        {categoryLabel(category)}
      </span>
      <span class="font-mono text-[10px] text-slate-400">{dateLabel}</span>
    </div>

    <h3 class:list={['mt-3 font-bold leading-snug text-slateink', featured ? 'text-xl sm:text-2xl' : 'text-[15px]']}>
      <a href={`/peppedia/${entry.id}`} class="hover:text-ocean-700">{title}</a>
    </h3>

    <p class:list={['mt-2 text-slate-600', featured ? 'text-sm leading-6' : 'line-clamp-3 text-xs leading-5']}>
      {description}
    </p>

    <div class="mt-auto flex items-center justify-between pt-4">
      <span class="font-mono text-[10px] text-slate-400">{readingMinutes} min read</span>
      <a href={`/peppedia/${entry.id}`} class="inline-flex items-center gap-1 text-xs font-semibold text-ocean-700 hover:text-ocean-800">
        Read
        <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10.3 3.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4-1.4l4.3-4.3H3a1 1 0 1 1 0-2h11.6l-4.3-4.3a1 1 0 0 1 0-1.4z" />
        </svg>
      </a>
    </div>
  </div>
</article>
