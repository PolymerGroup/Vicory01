---
import type { Faq } from '../types/peptide';

interface Props {
  faqs: Faq[];
  title?: string;
  class?: string;
}

const { faqs, title = 'Frequently asked questions', class: cls = '' } = Astro.props;
---

<section class:list={[{}, cls]} aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-xl font-bold text-slateink">{title}</h2>
  <p class="mt-1 text-sm text-slate-500">
    Procurement, documentation and handling questions for research buyers.
  </p>

  <div class="mt-5 divide-y divide-slate-200 overflow-hidden rounded-2xl border border-slate-200 bg-white">
    {
      faqs.map((f, i) => (
        <details class="group px-5 py-4" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-[15px] font-semibold text-slateink">
            <span>{f.q}</span>
            <span class="mt-0.5 shrink-0 text-slate-400 transition-transform group-open:rotate-45">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-600">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
